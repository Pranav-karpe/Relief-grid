# ReliefGrid environment configuration placeholders
# Never put real passwords, tokens, or API keys in this file.
PORT=5000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

# Brevo SMTP Transactional Email Configuration
# 1. Sign up at https://brevo.com
# 2. Navigate to SMTP & API -> SMTP tab -> Generate a new SMTP key
# 3. Verify your sender email address or domain under Senders & IP -> Senders
# Note: Brevo rejects emails if EMAIL_FROM is not verified in your Brevo account.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="<your-brevo-smtp-login>"
SMTP_PASS="<your-brevo-smtp-key>"
EMAIL_FROM="<your-verified-brevo-sender-email>"
EMAIL_FROM_NAME="ReliefGrid Team"
