{
  "name": "reliefgrid-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test:models": "tsx --test tests/models.test.ts",
    "test:auth": "tsx --test tests/auth.test.ts",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mongoose": "^9.11.2",
    "resend": "^6.37.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "mongodb-memory-server": "^10.4.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
